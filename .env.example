# Admin login. Required in production - a build has no default, so every login
# is refused until this is set. `pnpm dev` falls back to "password".
# Leave the line commented out rather than empty: an empty value overrides the
# development default too.
# NUXT_ADMIN_PASSWORD=change-me

# Seals the admin session cookie, at least 32 characters. Required in
# production, same rules as above.
# NUXT_SESSION_PASSWORD=change-me-to-a-random-string-of-32-plus-chars

# Vimeo (optional - for listing media from Vimeo API)
NUXT_VIMEO_API_TOKEN=

# Support address offered to visitors whose access link has expired (optional)
NUXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# White-label theme (all optional) - see docs/theming.md
NUXT_PUBLIC_THEME_TITLE=Media Access Manager
NUXT_PUBLIC_THEME_LOGO=/logo.svg
NUXT_PUBLIC_THEME_LOGO_DARK=/logo-dark.svg
NUXT_PUBLIC_THEME_LOGO_HEIGHT=2rem
NUXT_PUBLIC_THEME_FAVICON=/favicon.ico

# Brand colors: a hex/CSS color, or the name of a Tailwind palette ("blue", "slate", ...)
# Quote hex values! An unquoted "#" starts a comment, so PRIMARY=#0f4c81 arrives empty.
NUXT_PUBLIC_THEME_COLORS_PRIMARY="#0f4c81"
NUXT_PUBLIC_THEME_COLORS_NEUTRAL=slate
NUXT_PUBLIC_THEME_COLORS_SECONDARY=
NUXT_PUBLIC_THEME_COLORS_SUCCESS=
NUXT_PUBLIC_THEME_COLORS_INFO=
NUXT_PUBLIC_THEME_COLORS_WARNING=
NUXT_PUBLIC_THEME_COLORS_ERROR=

# Shape and density
NUXT_PUBLIC_THEME_RADIUS=0.25rem
NUXT_PUBLIC_THEME_SPACING=0.25rem
NUXT_PUBLIC_THEME_CONTAINER=80rem
