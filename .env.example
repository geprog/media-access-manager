# Admin login. Required in production - a build has no default, so every login
# is refused until this is set. `pnpm dev` falls back to "password".
# Leave the line commented out rather than empty: an empty value overrides the
# development default too.
# NUXT_ADMIN_PASSWORD=change-me

# Seals the admin session cookie, at least 32 characters. Required in
# production, same rules as above.
# NUXT_SESSION_PASSWORD=change-me-to-a-random-string-of-32-plus-chars

# Vimeo (optional - for listing media from Vimeo API)
NUXT_VIMEO_API_TOKEN=

# Support address offered to visitors whose access link has expired (optional)
NUXT_PUBLIC_SUPPORT_EMAIL=support@example.com

# Who is responsible for the media here - the company handing the links out,
# not a media provider like Vimeo. Shown to visitors and admins both as an icon
# next to the brand and in the footer (optional). The name defaults to
# NUXT_PUBLIC_THEME_TITLE.
NUXT_PUBLIC_PUBLISHER_URL=https://example.com
NUXT_PUBLIC_PUBLISHER_NAME=Example Company

# Footer credit, shown to visitors and admins (optional). Defaults to the
# upstream project; set your own to take the credit, or leave the name empty
# to drop the line entirely.
NUXT_PUBLIC_POWERED_BY_NAME=Media Access Manager
NUXT_PUBLIC_POWERED_BY_URL=https://github.com/geprog/media-access-manager

# White-label theme (all optional) - see docs/theming.md
NUXT_PUBLIC_THEME_TITLE=Media Access Manager
NUXT_PUBLIC_THEME_LOGO_HEIGHT=2rem

# Logo and favicon. Empty by default: the header shows the title as text and
# the browser its own tab icon until a deployment names a file here. Put the
# file in ./branding - or mount it at /app/branding in a container - and point
# at it as /branding/<name>; that directory is read at request time, so a
# published image needs no rebuild. Only the files these settings name are
# served. An absolute URL (https://cdn.example/logo.svg) works too.
# Do not put branding in `public/` in a container: that directory is fixed when
# the image is built, and a file added later is answered with the app's HTML
# instead of the image.
NUXT_PUBLIC_THEME_LOGO=/branding/logo.svg
NUXT_PUBLIC_THEME_FAVICON=/branding/favicon.ico

# A dark-mode variant, shown instead of the logo above. Mount both files: they
# render at once with one hidden by CSS, so this is ignored on its own.
NUXT_PUBLIC_THEME_LOGO_DARK=/branding/logo-dark.svg

# Where those files are read from (optional). Relative to the working
# directory, which is /app in the container image. Keep it under /app - the
# container runs Node with --allow-fs-read=/app. Empty switches the route off.
# NUXT_BRANDING_DIR=branding

# Brand colors: a hex/CSS color, or the name of a Tailwind palette ("blue", "slate", ...)
# Quote hex values! An unquoted "#" starts a comment, so PRIMARY=#0f4c81 arrives empty.
NUXT_PUBLIC_THEME_COLORS_PRIMARY="#0f4c81"
NUXT_PUBLIC_THEME_COLORS_NEUTRAL=slate
NUXT_PUBLIC_THEME_COLORS_SECONDARY=
NUXT_PUBLIC_THEME_COLORS_SUCCESS=
NUXT_PUBLIC_THEME_COLORS_INFO=
NUXT_PUBLIC_THEME_COLORS_WARNING=
NUXT_PUBLIC_THEME_COLORS_ERROR=

# Shape and density
NUXT_PUBLIC_THEME_RADIUS=0.25rem
NUXT_PUBLIC_THEME_SPACING=0.25rem
NUXT_PUBLIC_THEME_CONTAINER=80rem
