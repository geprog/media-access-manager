{
  "name": "nuxt-template",
  "type": "module",
  "private": true,
  "packageManager": "pnpm@10.30.3",
  "engines": {
    "pnpm": ">=9.0.0",
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "nuxt build",
    "dev": "nuxt dev",
    "lint": "eslint",
    "spelling": "cspell lint --no-progress '**'",
    "typecheck": "nuxt typecheck",
    "preview": "nuxt preview",
    "postinstall": "nuxt prepare",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "test": "vitest",
    "test:e2e": "playwright test",
    "playwright:install": "playwright install && playwright install-deps"
  },
  "dependencies": {
    "@extractus/oembed-extractor": "6.0.0",
    "@nuxt/ui": "4.11.0",
    "@nuxtjs/i18n": "10.6.0",
    "archiver": "8.0.0",
    "bcrypt": "6.0.0",
    "better-sqlite3": "13.0.3",
    "culori": "4.0.2",
    "drizzle-orm": "0.45.2",
    "nuxt": "4.5.2",
    "nuxt-auth-utils": "0.5.30",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4",
    "sharp": "0.35.4",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@antfu/eslint-config": "9.3.0",
    "@cspell/dict-de-de": "4.1.2",
    "@nuxt/test-utils": "4.2.0",
    "@playwright/test": "1.62.1",
    "@types/archiver": "8.0.0",
    "@types/bcrypt": "6.0.0",
    "@types/better-sqlite3": "9.6.0",
    "@types/culori": "4.0.1",
    "@types/qrcode": "1.5.6",
    "@vue/test-utils": "2.5.0",
    "cspell": "10.1.1",
    "dotenv": "17.4.2",
    "drizzle-kit": "0.31.10",
    "eslint": "10.9.1",
    "eslint-plugin-format": "2.0.1",
    "happy-dom": "20.12.0",
    "vitest": "4.1.11",
    "vue-tsc": "3.3.11"
  }
}
