{
  "version": "0.2",
  "import": [
    "@cspell/dict-de-de/cspell-ext.json"
  ],
  "language": "en",
  "ignorePaths": [
    "pnpm-lock.yml",
    ".vscode/settings.json",
    ".cspell.json",
    ".nuxt",
    "pnpm-lock.yaml",
    "playwright-report",
    "test-results",
    "server/db/migrations/**"
  ],
  "words": [
    "anmelden",
    "autoincrement",
    "demi",
    "dprint",
    "esbuild",
    "extractus",
    "geprog",
    "labelable",
    "npmjs",
    "nuxt",
    "nuxtjs",
    "oembed",
    "qrcode",
    "unrs",
    "wrongpassword"
  ],
  "overrides": [
    {
      "filename": [
        "i18n/locales/de.json"
      ],
      "language": "de,en",
      "words": []
    }
  ]
}
